{
  "name": "nutrilens-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "NutriLens — fully offline, in-browser food recognition and nutrition estimation PWA",
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "fetch-assets": "bash tools/fetch-assets.sh",
    "build:db": "node tools/build-nutrition-db.mjs",
    "build:embeddings": "node tools/build-embeddings.mjs",
    "dev": "npm --workspace app run dev",
    "build": "npm --workspace app run build",
    "preview": "npm --workspace app run preview",
    "test": "vitest run",
    "test:nutrition-ui": "node eval/nutrition-e2e.mjs",
    "test:vision": "node eval/vision-bench.mjs",
    "test:tracker": "node eval/tracker-e2e.mjs",
    "test:smoke": "node eval/browser-smoke.mjs",
    "test:offline": "node eval/offline-test.mjs",
    "eval": "node eval/run-eval.mjs",
    "eval:fetch": "node eval/fetch-dataset.mjs",
    "eval:report": "node eval/make-report.mjs",
    "probe:dataset": "node tools/build-probe-dataset.mjs",
    "probe:crops": "node tools/harvest-crops.mjs",
    "probe:labels": "node tools/add-crop-labels.mjs",
    "probe:train": "node tools/train-probe.mjs --epochs 1500 --lr 8 --l2 1e-4",
    "probe:eval": "node tools/eval-probe.mjs",
    "probe:trusted": "node tools/select-trusted.mjs --write",
    "diagnose": "node eval/diagnose-recall.mjs",
    "tune": "node eval/tune-fusion.mjs",
    "verify:nutrition": "node tools/verify-nutrition-claude.mjs",
    "adjudicate:nutrition": "node tools/adjudicate-claude.mjs",
    "build:catalogue": "node tools/build-food-catalogue.mjs",
    "build:library": "node tools/compute-food-library.mjs",
    "test:stability": "node eval/stability.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.5.0",
    "onnxruntime-node": "^1.27.0",
    "puppeteer-core": "^25.3.0",
    "sharp": "^0.34.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.110.0"
  }
}
